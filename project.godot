; dot-core — shared foundation for the dot-* Godot asset family.
;
; This project exists so the addon can be opened, edited and validated on its
; own. Consumers copy `addons/dot_core/` into their own project; nothing here
; outside that folder is part of the distributable.

config_version=5

[application]

config/name="dot-core"
config/description="Shared foundation for the dot-* Godot asset family."
config/version="0.1.0"
run/main_scene="res://examples/capability_report.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[editor_plugins]

enabled=PackedStringArray("res://addons/dot_core/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
